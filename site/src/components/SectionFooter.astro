---
import toc from "../generated-toc.json";

interface Props { kind: "examples" | "exercises"; slug: string; }
const { kind, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const sections = (toc as Record<string, Array<{ slug: string; title: string }>>)[kind] ?? [];
const i = sections.findIndex((s) => s.slug === slug);
const prev = i > 0 ? sections[i - 1] : null;
const next = i >= 0 && i < sections.length - 1 ? sections[i + 1] : null;
const indexHref = `${base}${kind}/`;
const kindLabel = kind === "examples" ? "Examples" : "Exercises";
---
<nav class="mt-12 border-t border-slate-200 dark:border-slate-800 pt-6" aria-label="Section navigation">
  <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
    <div class="flex-1 min-w-0">
      {prev ? (
        <a href={`${base}${kind}/${prev.slug}`} class="group flex flex-col gap-0.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-brand-500 transition px-4 py-3 no-underline">
          <span class="text-xs text-slate-500 dark:text-slate-400">← Previous</span>
          <span class="font-semibold text-slate-900 dark:text-slate-100 truncate">{prev.title}</span>
        </a>
      ) : (
        <a href={indexHref} class="group flex flex-col gap-0.5 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-brand-500 transition px-4 py-3 no-underline">
          <span class="text-xs text-slate-500 dark:text-slate-400">← Back</span>
          <span class="font-semibold text-slate-900 dark:text-slate-100">{kindLabel} home</span>
        </a>
      )}
    </div>
    <div class="flex-1 min-w-0">
      {next ? (
        <a href={`${base}${kind}/${next.slug}`} class="group flex flex-col gap-0.5 rounded-lg border border-brand-500/40 hover:border-brand-500 bg-brand-50/40 dark:bg-brand-500/10 transition px-4 py-3 no-underline text-right">
          <span class="text-xs text-brand-700 dark:text-brand-100">Next →</span>
          <span class="font-semibold text-slate-900 dark:text-slate-100 truncate">{next.title}</span>
        </a>
      ) : (
        <a href={indexHref} class="group flex flex-col gap-0.5 rounded-lg border border-emerald-500/40 hover:border-emerald-500 bg-emerald-50/40 dark:bg-emerald-500/10 transition px-4 py-3 no-underline text-right">
          <span class="text-xs text-emerald-700 dark:text-emerald-300">🎉 You've reached the end!</span>
          <span class="font-semibold text-slate-900 dark:text-slate-100">Back to {kindLabel} home</span>
        </a>
      )}
    </div>
  </div>
</nav>
